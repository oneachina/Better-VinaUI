# Normalize all text files to CRLF in repository and working tree.
* text=auto eol=crlf

# Explicit text types used in this repository.
*.h text eol=crlf
*.hpp text eol=crlf
*.c text eol=crlf
*.cc text eol=crlf
*.cpp text eol=crlf
*.cxx text eol=crlf
*.inl text eol=crlf
*.ipp text eol=crlf
*.rc text eol=crlf
*.rc2 text eol=crlf
*.cmake text eol=crlf
CMakeLists.txt text eol=crlf
*.yml text eol=crlf
*.yaml text eol=crlf
*.md text eol=crlf
*.txt text eol=crlf
*.json text eol=crlf
*.gitignore text eol=crlf
*.gitattributes text eol=crlf

# Keep common assets as binary.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.zip binary
*.7z binary
*.dll binary
*.lib binary
*.exe binary
